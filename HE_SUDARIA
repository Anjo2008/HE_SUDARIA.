#include <stdio.h>

int main() {
    float balance = 500.00;
    int choice;
    float amount;

    do {
        printf("BSIT BANK\n");
        printf("Please Select your Transaction\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1: // Balance Inquiry
                printf("\nYour current balance: P%.2f\n\n", balance);
                break;

            case 2: // Deposit
                printf("Enter amount to deposit: ");
                scanf("%f", &amount);
                if (amount > 0) {
                    balance += amount;
                    printf("P%.2f deposited successfully!\n\n", amount);
                } else {
                    printf("Invalid amount!\n\n");
                }
                break;

            case 3: // Withdraw
                printf("Enter amount to withdraw: ");
                scanf("%f", &amount);
                // Check if balance will go below 100
                if (balance - amount < 100) {
                    printf("Withdrawal denied! You must maintain at least P100.00 in your account\n\n");
                } else {
                    if (amount > 0) {
                        balance -= amount;
                        printf("You withdrew P%.2f successfully!\n\n", amount);
                    } else {
                        printf("Invalid amount!\n\n");
                    }
                }
                break;

            case 4: // Exit
                printf("Thank you for using BSIT BANK!\n");
                break;

            default:
                printf("Invalid choice! Please try again.\n\n");
                break;
        }

    } while (choice != 4);

    return 0;
}
